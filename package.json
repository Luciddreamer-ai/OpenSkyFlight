{
  "name": "openskylight",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/serve.js",
    "lint": "eslint js/ games/ scripts/",
    "lint:fix": "eslint js/ games/ scripts/ --fix",
    "format": "prettier --write \"js/**/*.js\" \"games/**/*.js\" \"*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"js/**/*.js\" \"games/**/*.js\" \"*.js\" \"scripts/**/*.js\"",
    "check:imports": "node scripts/check-imports.mjs",
    "ci": "npm run lint && npm run format:check && npm run check:imports && npm run check:diagnostics",
    "check:diagnostics": "node scripts/check-diagnostics.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
